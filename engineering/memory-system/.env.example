# 记忆系统环境变量样例（复制成 .env 后按需修改；不要把真实密钥提交进仓库）

# 记忆整合器后端：keyword（默认，关键词重叠 + 截断）| openai（LLM 摘要）
CONSOLIDATOR_PROVIDER=keyword

# 逗号分隔的 CORS 白名单，例如 https://a.example.com,https://b.example.com
# 留空则不挂 CORS 中间件（并在启动时告警）
MEMORY_CORS_ORIGINS=

# openai 后端必填：Consolidator 会先做一次本地 LLM 调用，失败再回退关键词模式
OPENAI_API_KEY=

# LLM 整合使用的模型，仅 openai 后端生效
LLM_MODEL=gpt-4o-mini
