# agent-long-term-memory — environment variables
# Copy to .env and fill in real values. Never commit .env.

# LLM provider used by the consolidation service (openai | anthropic | local | none)
CONSOLIDATOR_PROVIDER=openai

# Model used by the consolidation service
LLM_MODEL=gpt-4o-mini

# Comma-separated allowed origins for the API's CORS layer.
# Empty means CORS is disabled entirely -- do not set it to "*".
MEMORY_CORS_ORIGINS=

# API key for the provider named by CONSOLIDATOR_PROVIDER
OPENAI_API_KEY=
